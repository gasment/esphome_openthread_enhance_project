{
  "title": "Thread Proxy",
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Set up BR access management",
        "description": "Set up the shared manager, then discover or add BRs on its management page. BRs do not create individual config entries."
      },
      "confirm": {
        "title": "Bind {name}",
        "description": "Bind {name} at {host}:{port}?",
        "data": {
          "noise_psk": "API encryption key (optional)",
          "create_device": "Create the BR device and diagnostic entities"
        }
      }
    },
    "error": {
      "invalid_host": "Invalid host address.",
      "invalid_port": "Port must be between 1 and 65535.",
      "invalid_key": "Key must be 32 bytes encoded as Base64.",
      "invalid_input": "Invalid input.",
      "already_configured": "This BR is already bound.",
      "manager_not_ready": "The manager is not ready. Please try again shortly."
    },
    "abort": {
      "already_configured": "This BR is already bound.",
      "invalid_discovery": "Invalid proxy announcement.",
      "unsupported_protocol": "Unsupported proxy protocol version.",
      "binding_added": "The BR was added to access management."
    },
    "initiate_flow": {
      "user": "Manage BR access"
    }
  },
  "entity": {
    "sensor": {
      "status": {
        "name": "Proxy status",
        "state": {
          "connecting": "Connecting",
          "connected": "API connected",
          "ready": "Proxy protocol verified",
          "disconnected": "Disconnected",
          "unsupported": "Proxy protocol unavailable",
          "auth_error": "Authentication failed",
          "identity_mismatch": "BR identity mismatch",
          "duplicate_identity": "Duplicate BR binding"
        }
      }
    },
    "binary_sensor": {
      "bound": {
        "name": "Bound"
      },
      "api_connected": {
        "name": "API connected"
      },
      "proxy_ready": {
        "name": "Proxy protocol verified"
      }
    }
  }
}
