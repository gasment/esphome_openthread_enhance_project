# Only used when creating the administrator for the first time (minimum 12 characters).
BR_ADMIN_USER=admin
BR_ADMIN_PASSWORD=replace-with-a-long-random-password
BR_PORT=8080
BR_BIND=0.0.0.0
# First available port is selected when admitting a BR. Each BR can override it.
BR_PROXY_PORT_START=18001
BR_PROXY_PORT_END=18100
# Set true when the browser accesses the manager through your HTTPS reverse proxy.
BR_COOKIE_SECURE=false
BR_SESSION_HOURS=12
# Optional comma-separated local interface IPs for mDNS, e.g. 192.168.32.10,fe80::1%eth0.
# Empty selects available interfaces. Must use addresses present on the Linux host.
BR_MDNS_INTERFACES=
