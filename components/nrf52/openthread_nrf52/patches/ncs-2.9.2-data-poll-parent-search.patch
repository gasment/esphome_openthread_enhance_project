+#if defined(OPENTHREAD_CONFIG_ESPHOME_POLL_PARENT_SEARCH)
+void Mle::SearchForBetterParentAfterPoll(int8_t aRss)
+{
+    if (!IsChild() || IsRxOnWhenIdle() || IsAttaching() || aRss == Radio::kInvalidRssi)
+    {
+        return;
+    }
+
+#ifdef OPENTHREAD_CONFIG_ESPHOME_POLL_PARENT_SEARCH_THRESHOLD
+    if (aRss >= OPENTHREAD_CONFIG_ESPHOME_POLL_PARENT_SEARCH_THRESHOLD)
+    {
+        return;
+    }
+#endif
+
+    Attach(kBetterParent);
+    mPollParentSearchRss = aRss;
+}
+#endif
