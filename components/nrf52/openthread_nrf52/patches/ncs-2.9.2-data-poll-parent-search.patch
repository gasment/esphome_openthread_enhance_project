+#if defined(OPENTHREAD_CONFIG_ESPHOME_POLL_PARENT_SEARCH)
+void Mle::SetPollParentSearchPaused(bool aPaused)
+{
+    if (mPollParentSearchPaused == aPaused)
+    {
+        return;
+    }
+    mPollParentSearchPaused = aPaused;
+
+    // Stop probing before Child ID Request. An already-started handoff must
+    // finish through the normal MLE state machine.
+    if (!aPaused || !IsChild() || mAttachMode != kBetterParent || mPollParentSearchRss == Radio::kInvalidRssi ||
+        (mAttachState != kAttachStateStart && mAttachState != kAttachStateParentRequest))
+    {
+        return;
+    }
+
+    mAttachTimer.Stop();
+    mParentCandidate.Clear();
+    mPollParentSearchRss = Radio::kInvalidRssi;
+    SetAttachState(kAttachStateIdle);
+    if (!IsRxOnWhenIdle())
+    {
+        Get<MeshForwarder>().SetRxOnWhenIdle(false);
+    }
+    LogInfo("Data poll parent search paused for application traffic");
+}
+
+void Mle::SearchForBetterParentAfterPoll(int8_t aRss)
+{
+    if (mPollParentSearchPaused || !IsChild() || IsRxOnWhenIdle() || IsAttaching() || aRss == Radio::kInvalidRssi)
+    {
+        return;
+    }
+    if (mChildUpdateRequestState != kChildUpdateRequestNone || mDataRequestState != kDataRequestNone)
+    {
+        return;
+    }
+
+#ifdef OPENTHREAD_CONFIG_ESPHOME_POLL_PARENT_SEARCH_THRESHOLD
+    if (aRss >= OPENTHREAD_CONFIG_ESPHOME_POLL_PARENT_SEARCH_THRESHOLD)
+    {
+        return;
+    }
+#endif
+
+    Attach(kBetterParent);
+    mPollParentSearchRss = aRss;
+    LogInfo("Data poll parent search: parent 0x%04x RSS %d", mParent.GetRloc16(), aRss);
+}
+#endif
